# Адрес тестового сервера API (без завершающего /). Пустое значение = демо.
VITE_API_URL=
# development / staging / production
VITE_ANALYTICS_ENV=development
# Optional: comma-separated numeric IDs of test accounts
VITE_ANALYTICS_TEST_USER_IDS=

# Номер счётчика Яндекс Метрики. Без номера Метрика не загружается.
VITE_YANDEX_METRIKA_ID=114072239
